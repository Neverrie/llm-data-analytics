# Supported values: openrouter, gemini, dashscope, ollama
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# DashScope / Qwen OpenAI-compatible API
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# Code interpreter
LAB3_CODE_INTERPRETER_ENGINE=tool_calling

# Web / API
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003

# Sandbox
SANDBOX_RUNNER_MODE=docker
SANDBOX_DOCKER_IMAGE=llm-data-analytics-sandbox:latest
SANDBOX_DOCKER_USER=1000:1000
SANDBOX_ALLOW_ROOT_RETRY=false

# Required for Docker sandbox bind mounts.
# Use absolute host paths.
HOST_OUTPUTS_DIR=/absolute/path/to/project/outputs
HOST_DATASETS_DIR=/absolute/path/to/project/datasets

# Storage
DATASETS_DIR=/datasets
OUTPUTS_DIR=/outputs